#!/usr/bin/env bash
set -euo pipefail

readonly SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly USER_HOME="/home/cambricon"

systemctl disable --now atrust-route-guard.service 2>/dev/null || true
systemctl stop atrust-doh-dns-proxy.service 2>/dev/null || true

rm -f \
  /etc/systemd/system/atrust-route-guard.service \
  /etc/systemd/system/atrust-doh-dns-proxy.service \
  /usr/local/sbin/atrust-route-guard \
  /usr/local/sbin/atrust-split-on \
  /usr/local/sbin/atrust-split-off \
  /usr/local/sbin/atrust-network-check \
  "$USER_HOME/bin/atrust-dns-test" \
  "$USER_HOME/bin/atrust-dns-test.pre-scoped.bak" \
  "$USER_HOME/bin/atrust-doh-dns-proxy" \
  "$USER_HOME/bin/atrust-split-on" \
  "$USER_HOME/bin/atrust-split-on.pre-route-guard.bak" \
  "$USER_HOME/bin/atrust-split-on.pre-scoped.bak" \
  "$USER_HOME/bin/atrust-split-off" \
  "$USER_HOME/bin/atrust-split-off.pre-route-guard.bak" \
  "$USER_HOME/bin/atrust-split-off.pre-scoped.bak" \
  "$USER_HOME/bin/atrust-split-status" \
  "$USER_HOME/bin/atrust-split-status.pre-route-guard.bak" \
  "$USER_HOME/bin/atrust-split-status.pre-scoped.bak" \
  "$USER_HOME/bin/code-atrust" \
  "$USER_HOME/bin/code-atrust.pre-company-bypass.bak" \
  "$USER_HOME/bin/codex-atrust" \
  "$USER_HOME/bin/codex-atrust.pre-company-bypass.bak" \
  "$USER_HOME/.local/bin/atrust-secure-chrome.pre-company-bypass.bak" \
  "$USER_HOME/.local/bin/__pycache__/atrust-browser-proxycpython-313.pyc" \
  "$USER_HOME/bin/__pycache__/atrust-doh-dns-proxycpython-313.pyc" \
  /run/atrust-10-10-150-route.previous \
  /run/atrust-10-10-150-route.state

rm -rf "$USER_HOME/.local/share/atrust-split"

install -o root -g root -m 0755 "$SOURCE_DIR/atrust-mode-start-root" /usr/local/sbin/atrust-mode-start-root
install -o root -g root -m 0755 "$SOURCE_DIR/atrust-fast-exit-root" /usr/local/sbin/atrust-fast-exit-root
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/atrust-browser-proxy" "$USER_HOME/.local/bin/atrust-browser-proxy"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/atrust-proxy-start" "$USER_HOME/bin/atrust-proxy-start"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/codex" "$USER_HOME/bin/codex"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/code" "$USER_HOME/.local/bin/code"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/atrust-secure-chrome" "$USER_HOME/.local/bin/atrust-secure-chrome"
install -d -o cambricon -g cambricon "$USER_HOME/.local/share/icons/hicolor/scalable/apps"
install -o cambricon -g cambricon -m 0644 "$SOURCE_DIR/atrust-secure-chrome.svg" "$USER_HOME/.local/share/icons/hicolor/scalable/apps/atrust-secure-chrome.svg"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/atrust-mode-start" "$USER_HOME/.local/bin/atrust-mode-start"
install -o cambricon -g cambricon -m 0755 "$SOURCE_DIR/atrust-fast-exit" "$USER_HOME/.local/bin/atrust-fast-exit"
install -o cambricon -g cambricon -m 0644 "$SOURCE_DIR/atrust-mode-start.desktop" "$USER_HOME/.local/share/applications/atrust-mode-start.desktop"
install -o cambricon -g cambricon -m 0644 "$SOURCE_DIR/atrust-secure-chrome.desktop" "$USER_HOME/.local/share/applications/atrust-secure-chrome.desktop"
install -o cambricon -g cambricon -m 0644 "$SOURCE_DIR/atrust-fast-exit.desktop" "$USER_HOME/.local/share/applications/atrust-fast-exit.desktop"
install -o cambricon -g cambricon -m 0644 "$SOURCE_DIR/code.desktop" "$USER_HOME/.local/share/applications/code.desktop"

systemctl daemon-reload
update-desktop-database "$USER_HOME/.local/share/applications" 2>/dev/null || true
