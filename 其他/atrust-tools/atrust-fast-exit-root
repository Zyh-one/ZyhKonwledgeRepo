#!/usr/bin/env bash
set -u

systemctl stop aTrustDaemon.service 2>/dev/null || true

pkill -TERM -f '^/usr/share/sangfor/aTrust/resources/bin/aTrustXtunnel-64( |$)' 2>/dev/null || true
pkill -TERM -f '^/usr/share/sangfor/aTrust/resources/bin/aTrustAgent( |$)' 2>/dev/null || true
pkill -TERM -f '^/usr/share/sangfor/aTrust/aTrustTray( |$)' 2>/dev/null || true
sleep 2
pkill -KILL -f '^/usr/share/sangfor/aTrust/resources/bin/aTrustXtunnel-64( |$)' 2>/dev/null || true
pkill -KILL -f '^/usr/share/sangfor/aTrust/resources/bin/aTrustAgent( |$)' 2>/dev/null || true
pkill -KILL -f '^/usr/share/sangfor/aTrust/aTrustTray( |$)' 2>/dev/null || true

while read -r iface; do
  [[ -n "$iface" ]] && ip link delete dev "$iface" 2>/dev/null || true
done < <(ip -o link show | awk -F': ' '$2 ~ /^utun[0-9]+$/ {print $2}')

ip -4 route del 10.10.150.0/24 proto 186 2>/dev/null || true
resolvectl flush-caches 2>/dev/null || true
