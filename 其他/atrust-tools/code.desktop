[Desktop Entry]
Name=Visual Studio Code
Comment=Code Editing with reliable Codex connectivity
GenericName=Text Editor
Exec=/home/cambricon/.local/bin/code %F
Icon=vscode
Type=Application
StartupNotify=false
StartupWMClass=Code
Categories=TextEditor;Development;IDE;
MimeType=application/x-code-workspace;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/home/cambricon/.local/bin/code --new-window %F
Icon=vscode
