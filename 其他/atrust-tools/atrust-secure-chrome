#!/usr/bin/env bash
set -u

readonly PROFILE_DIR="$HOME/.local/share/atrust-secure-chrome/profile"
readonly PROXY="127.0.0.1:18787"
readonly LOCK_FILE="$HOME/.local/share/atrust-secure-chrome/launcher.lock"

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "aTrust 专用 Chrome" "$1"
}

if ! ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^utun[0-9]+$/ && $4 !~ /^2\.0\.0\.1\// { found=1 } END { exit !found }'; then
  notify "未检测到 aTrust 在线隧道，请先登录。"
  exit 1
fi

mkdir -p "$PROFILE_DIR"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  notify "专用浏览器已经在运行。"
  exit 0
fi

# Do not let the long-lived proxy inherit fd 9, otherwise it keeps the
# browser-instance lock after Chrome exits and causes a false "already running".
if ! "$HOME/bin/atrust-proxy-start" 9>&-; then
  notify "18787 代理启动失败。"
  exit 1
fi

/opt/google/chrome/google-chrome \
  --user-data-dir="$PROFILE_DIR" \
  --class=aTrustSecureChrome \
  --proxy-server="http://$PROXY" \
  --proxy-bypass-list="<-loopback>;*.cambricon.com" \
  --disable-quic \
  --disable-features=UseDnsHttpsSvcb,UseDnsHttpsSvcbAlpn \
  --new-window \
  "https://chatgpt.com/" \
  "https://gemini.google.com/" \
  "$@"
