[Unit]
Description=Persistent SSH tunnel from aTrust bastion to server 50
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -F /home/cambricon/sshTool/ssh_config -N -L 127.0.0.1:6009:10.10.150.50:2023 -o ExitOnForwardFailure=yes atrust-bastion
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
